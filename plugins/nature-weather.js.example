// 🌦 Nature & Weather — 7-day forecasts for the places that matter, plus the moulin's
// river gauge. Locations come from two sources: PINNED (permanent, kept in this plugin's
// synced store) and AUTO (wherever the location-tracking bars say you are or are going).
// Toggle any location off; 📌-pin an auto one to keep it. Salient weather is surfaced to
// the Agent Brief via the briefItems() hook. All data free / no key (Open-Meteo, Hub'Eau,
// VigiEau). Private plugin — never ships to the stub.
const fs = require('fs'), path = require('path');
const OM = 'https://api.open-meteo.com/v1/forecast';
const GEO = 'https://geocoding-api.open-meteo.com/v1/search';
const STORE = path.join(__dirname, '..', 'data', 'weather-locations.json');
const LOCBARS = path.join(__dirname, '..', 'data', 'location-bars-local.json');
const CELL = "'Heartbeat'!R1"; // cross-tier sync of pinned/off state (newest-wins)
const TTL = 30 * 60 * 1000;

async function getJson(url) {
  const c = new AbortController(); const t = setTimeout(() => c.abort(), 20000);
  try { const r = await fetch(url, { headers: { 'User-Agent': 'dashboard-weather/1.0' }, signal: c.signal }); return r.ok ? r.json() : null; }
  catch (e) { return null; } finally { clearTimeout(t); }
}
const readStore = () => { try { const j = JSON.parse(fs.readFileSync(STORE, 'utf8')); return { pinned: j.pinned || [], off: (j.off || []), geo: j.geo || {}, surf: j.surf || {}, savedAt: j.savedAt || 0 }; } catch (e) { return { pinned: [], off: [], geo: {}, surf: {}, savedAt: 0 }; } }; // pinned:[{name,lat,lon,label}], off:[name], geo:{key:{lat,lon,label}}
function writeStore(s, ctx) {
  s.savedAt = Date.now();
  try { fs.writeFileSync(STORE, JSON.stringify(s)); } catch (e) {}
  const sid = ctx && ctx.config && ctx.config.todoSheetId;
  if (ctx && ctx.store && sid) ctx.store.values.update({ spreadsheetId: sid, range: CELL, valueInputOption: 'RAW', requestBody: { values: [[JSON.stringify(s).slice(0, 49000)]] } }).catch(() => {});
}
async function syncStore(ctx) { // pull a newer remote, or push a newer local
  const sid = ctx && ctx.config && ctx.config.todoSheetId;
  if (!ctx || !ctx.store || !sid) return readStore();
  try {
    const r = await ctx.store.values.get({ spreadsheetId: sid, range: CELL });
    const raw = (((r.data.values || [[]])[0] || [])[0]) || '';
    let remote = null; try { remote = JSON.parse(raw); } catch (e) {}
    const local = readStore();
    if (remote && (remote.savedAt || 0) > (local.savedAt || 0)) { try { fs.writeFileSync(STORE, JSON.stringify(remote)); } catch (e) {} return remote; }
    return local;
  } catch (e) { return readStore(); }
}
const norm = s => String(s || '').trim().toLowerCase();
// distinct place names from the location bars over [today, +14d] — "where I am / am going"
function autoLocations() {
  let bars = [];
  try { bars = (JSON.parse(fs.readFileSync(LOCBARS, 'utf8')).bars) || []; } catch (e) {}
  const today = new Date().toISOString().slice(0, 10), horizon = new Date(Date.now() + 14 * 864e5).toISOString().slice(0, 10);
  const seen = new Set(), out = [];
  for (const b of bars.sort((a, c) => a.start.localeCompare(c.start))) {
    if (b.end < today || b.start > horizon) continue;
    const loc = String(b.location || '').trim();
    if (!loc || loc === 'Location?' || seen.has(norm(loc))) continue;
    seen.add(norm(loc)); out.push({ name: loc, start: b.start, end: b.end });
  }
  return out;
}
async function geocode(name, store, ctx) {
  const k = norm(name);
  if (store.geo[k]) return store.geo[k];
  const g = await getJson(`${GEO}?name=${encodeURIComponent(name)}&count=1&language=en`);
  const r = g && g.results && g.results[0];
  if (!r) { store.geo[k] = { lat: null, lon: null, label: name }; }
  else store.geo[k] = { lat: r.latitude, lon: r.longitude, label: [r.name, r.admin1, r.country_code].filter(Boolean).join(', ') };
  writeStore(store, ctx);
  return store.geo[k];
}
async function forecast(lat, lon) {
  if (lat == null) return null;
  const w = await getJson(`${OM}?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,wind_speed_10m_max&timezone=auto&forecast_days=7`);
  if (!w || !w.daily) return null;
  const d = w.daily;
  return {
    current: w.current ? { t: w.current.temperature_2m, code: w.current.weather_code } : null,
    days: d.time.map((date, i) => ({ date, code: d.weather_code[i], max: d.temperature_2m_max[i], min: d.temperature_2m_min[i], precip: d.precipitation_sum[i], pprob: d.precipitation_probability_max[i], wind: d.wind_speed_10m_max[i] })),
  };
}
// —— lunar phase (pure computation — no API) ——
const SYNODIC = 29.53058867, NEWMOON_REF = Date.UTC(2000, 0, 6, 18, 14) / 864e5;
function moonPhase() {
  const now = Date.now() / 864e5;
  const age = ((now - NEWMOON_REF) % SYNODIC + SYNODIC) % SYNODIC;
  const illum = (1 - Math.cos(2 * Math.PI * age / SYNODIC)) / 2;
  const waxing = age < SYNODIC / 2;
  const nextNew = new Date((NEWMOON_REF + Math.ceil((now - NEWMOON_REF) / SYNODIC) * SYNODIC) * 864e5);
  const nextFull = new Date((NEWMOON_REF + (Math.floor((now - NEWMOON_REF) / SYNODIC) + 0.5 <= (now - NEWMOON_REF) / SYNODIC ? Math.floor((now - NEWMOON_REF) / SYNODIC) + 1.5 : Math.floor((now - NEWMOON_REF) / SYNODIC) + 0.5) * SYNODIC) * 864e5);
  return { illum: Math.round(illum * 100), waxing, nextNew: nextNew.toISOString().slice(0, 10), nextFull: nextFull.toISOString().slice(0, 10) };
}
// —— surf spots: waves + tides (Open-Meteo Marine, free/no-key) ——
// Known beaches get exact coords; anything else geocodes by name. Max 3 per location.
const KNOWN_SPOTS = {}; // 'place name': { lat, lon } — pre-seeded geocodes (optional)
const DEFAULT_SURF = {}; // 'your-place': ['Spot A', 'Spot B'] — add your own
async function spotCoords(name, store, ctx) {
  const k = norm(name);
  if (KNOWN_SPOTS[k]) return KNOWN_SPOTS[k];
  const g = await geocode(name, store, ctx);
  return g.lat != null ? { lat: g.lat, lon: g.lon } : null;
}
async function marine(lat, lon) {
  const m = await getJson(`https://marine-api.open-meteo.com/v1/marine?latitude=${lat}&longitude=${lon}&hourly=wave_height,wave_period,sea_level_height_msl&timezone=auto&forecast_days=2`);
  if (!m || !m.hourly) return null;
  const h = m.hourly, now = Date.now();
  const i0 = Math.max(1, h.time.findIndex(t => new Date(t).getTime() >= now));
  const sl = h.sea_level_height_msl;
  let hi = null, lo = null;
  for (let i = i0; i < sl.length - 1 && (!hi || !lo); i++) {
    if (sl[i] == null) continue;
    if (!hi && sl[i] >= sl[i - 1] && sl[i] > sl[i + 1]) hi = { t: h.time[i], v: sl[i] };
    if (!lo && sl[i] <= sl[i - 1] && sl[i] < sl[i + 1]) lo = { t: h.time[i], v: sl[i] };
  }
  return { wave: h.wave_height[i0], period: h.wave_period[i0], high: hi, low: lo };
}
async function surfFor(locName, store, ctx) {
  const names = (store.surf && store.surf[norm(locName)]) || DEFAULT_SURF[norm(locName)] || [];
  const out = [];
  for (const n of names.slice(0, 3)) {
    const c = await spotCoords(n, store, ctx);
    const m = c ? await marine(c.lat, c.lon) : null;
    out.push({ name: n, ...(m || { wave: null }) });
  }
  return out;
}
// —— Louet escalation watch (owner spec 2026-08-05) ——
// Hourly (Mac tier only): fetch the live gauge + latest quality panel, append to a local
// history file (14 days kept), and escalate:
//   medium (agent brief ⚠️): |flow Δ24h| > 50%, or a NEW quality reading > 2σ from its
//     recent trend (>30% absolute change when <4 samples exist for σ);
//   high (Signal via the Urgent Queue tab — your messenger agent delivers): flow Δ24h ≥ +100%.
// The moulin has a canal and a cours d'eau: a doubling of flow is a flood indicator.
// Every escalation appends to data/louet-escalations.jsonl; cooldowns stop re-fires
// (medium 12h per measurement, high 12h) while a condition persists.
const LHIST = path.join(__dirname, '..', 'data', 'louet-history.json');
const LESC = path.join(__dirname, '..', 'data', 'louet-escalations.jsonl');
const lread = () => { try { return JSON.parse(fs.readFileSync(LHIST, 'utf8')); } catch (e) { return { readings: [], lastAlert: {} }; } };
const lwrite = h => { try { fs.writeFileSync(LHIST, JSON.stringify(h)); } catch (e) {} };
const lesc = e => { try { fs.appendFileSync(LESC, JSON.stringify({ at: new Date().toISOString(), ...e }) + '\n'); } catch (e2) {} };
let louetBriefAlerts = []; // consumed by briefItems(); refreshed each check

// —— flow-series cache: 13+ months of daily means, incremental refresh ——
// Page loads NEVER hit Hub'Eau: /api/louet/series serves this cache instantly and kicks a
// background refresh when it is >6h old. Refresh fetches only from the last cached date
// (minus 2 days — the elaborated series revises recent values), merges, trims to 420 days.
const LFLOW = path.join(__dirname, '..', 'data', 'louet-flow-cache.json');
const lfRead = () => { try { return JSON.parse(fs.readFileSync(LFLOW, 'utf8')); } catch (e) { return { updatedAt: 0, daily: [] }; } };
let lfRefreshing = false;
async function louetFlowRefresh() {
  if (lfRefreshing) return; lfRefreshing = true;
  try {
    const c = lfRead();
    const last = c.daily.length ? c.daily[c.daily.length - 1].date : null;
    const from = last ? new Date(Date.parse(last) - 2 * 864e5) : new Date(Date.now() - 400 * 864e5);
    const since = from.toISOString().slice(0, 10);
    // ~400 daily rows max — one page (API caps size at 20000; sort param is IGNORED, series arrives date-ASC)
    const dj = await getJson(`${HUBEAU}/v2/hydrometrie/obs_elab?code_entite=${FLOW_STATION}&grandeur_hydro_elab=QmnJ&date_debut_obs_elab=${since}&size=500`);
    const fresh = ((dj && dj.data) || []).filter(o => o.resultat_obs_elab != null)
      .map(o => ({ date: o.date_obs_elab.slice(0, 10), m3s: o.resultat_obs_elab / 1000 }));
    if (fresh.length) {
      const map = new Map(c.daily.map(d => [d.date, d.m3s]));
      for (const f of fresh) map.set(f.date, f.m3s); // fresh wins (revisions)
      const merged = [...map.entries()].sort((a, b) => a[0].localeCompare(b[0])).map(([date, m3s]) => ({ date, m3s }));
      const cutoff = new Date(Date.now() - 420 * 864e5).toISOString().slice(0, 10);
      fs.writeFileSync(LFLOW, JSON.stringify({ updatedAt: Date.now(), daily: merged.filter(d => d.date >= cutoff) }));
    } else if (c.daily.length) { // source empty/unreachable — stamp the ATTEMPT only:
      // updatedAt keeps meaning "data this fresh" so staleness stays visible and the
      // hourly retry pacing below still fires (a restamped updatedAt used to mask both)
      fs.writeFileSync(LFLOW, JSON.stringify({ ...c, attemptedAt: Date.now() }));
    }
  } catch (e) {} finally { lfRefreshing = false; }
}

async function louetCheck(ctx) {
  if (process.env.DASHBOARD_NO_JOBS) return; // one watcher (the Mac), not one per tier
  const h = lread();
  const now = Date.now();
  // live flow + last-30d daily means (baseline + day-one 24h comparison)
  const tr = await getJson(`${HUBEAU}/v2/hydrometrie/observations_tr?code_entite=${FLOW_STATION}&grandeur_hydro=Q&size=1&sort=desc`);
  const cur = tr && tr.data && tr.data[0] ? tr.data[0].resultat_obs / 1000 : null;
  const since = new Date(now - 30 * 864e5).toISOString().slice(0, 10);
  const dj = await getJson(`${HUBEAU}/v2/hydrometrie/obs_elab?code_entite=${FLOW_STATION}&grandeur_hydro_elab=QmnJ&date_debut_obs_elab=${since}&size=40&sort=desc`);
  const daily = ((dj && dj.data) || []).filter(o => o.resultat_obs_elab != null)
    .map(o => ({ date: o.date_obs_elab, m3s: o.resultat_obs_elab / 1000 }));
  const qj = await getJson(`${HUBEAU}/v2/qualite_rivieres/analyse_pc?code_station=${Q_STATION}&size=200&sort=desc&fields=date_prelevement,libelle_parametre,resultat,symbole_unite`);
  const qlatest = {};
  for (const a of ((qj && qj.data) || [])) {
    const p = a.libelle_parametre, dd = a.date_prelevement;
    if (a.resultat != null && (!qlatest[p] || dd > qlatest[p].date)) qlatest[p] = { date: dd, value: +a.resultat, unit: a.symbole_unite || '' };
  }
  // append + trim history
  h.readings.push({ at: now, m3s: cur, q: qlatest });
  h.readings = h.readings.filter(r => now - r.at < 14 * 864e5);
  const alerts = [];
  const fire = (key, level, text, detail) => {
    const last = h.lastAlert[key] || 0;
    if (now - last < 12 * 3600e3) return; // cooldown
    h.lastAlert[key] = now;
    alerts.push({ key, level, text });
    lesc({ key, level, text, ...detail });
  };
  // ---- flow Δ24h: the reference is Hub'Eau's OWN realtime observation ~24h ago —
  // instantaneous vs instantaneous, from the same gauge series (the station keeps weeks
  // of points, so this works from day one). First implementation compared the live value
  // against a daily MEAN, which both mislabels the window and over-triggers on spiky
  // small-river data (2026-08-09). Own-history and fresh-daily remain as fallbacks only.
  if (cur != null) {
    const target = now - 24 * 3600e3;
    let ref = null, refSrc = '';
    try {
      const sinceIso = new Date(now - 26 * 3600e3).toISOString().slice(0, 19) + 'Z';
      const rt = await getJson(`${HUBEAU}/v2/hydrometrie/observations_tr?code_entite=${FLOW_STATION}&grandeur_hydro=Q&date_debut_obs=${sinceIso}&size=300&sort=asc`);
      const pts = ((rt && rt.data) || []).filter(o => o.resultat_obs != null)
        .map(o => ({ at: Date.parse(o.date_obs), m3s: o.resultat_obs / 1000 }));
      const near = pts.filter(p2 => Math.abs(p2.at - target) < 3 * 3600e3)
        .sort((a, b) => Math.abs(a.at - target) - Math.abs(b.at - target))[0];
      if (near) { ref = near.m3s; refSrc = `gauge ${new Date(near.at).toISOString().slice(0, 16)}Z`; }
    } catch (e) {}
    if (ref == null) {
      const cands = h.readings.filter(r => r.m3s != null && Math.abs(r.at - target) < 4 * 3600e3);
      if (cands.length) { ref = cands.sort((a, b) => Math.abs(a.at - target) - Math.abs(b.at - target))[0].m3s; refSrc = 'own sample 24h ago'; }
    }
    if (ref == null && daily.length) { // latest FRESH daily (series is date-ASC; lags at times)
      const fresh = daily.filter(d => Date.parse(d.date) > now - 3 * 864e5).pop();
      if (fresh) { ref = fresh.m3s; refSrc = `daily mean ${fresh.date}`; }
    }
    const avg7 = daily.slice(0, 7).length ? daily.slice(0, 7).reduce((a, b) => a + b.m3s, 0) / daily.slice(0, 7).length : null;
    if (ref != null && ref > 0) {
      const pct = ((cur - ref) / ref) * 100;
      const ctxTxt = `${ref.toFixed(2)}→${cur.toFixed(2)} m³/s` + (avg7 ? ` (moy 7j ${avg7.toFixed(2)})` : '');
      // Neutral, factual labels only (owner rule 2026-08-09): data + % change, no alarm words.
      if (pct >= 100)
        fire('flow-high', 'high', `Louet: flow ${pct >= 150 ? 'x' + (1 + pct / 100).toFixed(1) : 'doubled'} in 24h (${ctxTxt}) — check conditions`, { pct, cur, ref, refSrc, avg7 });
      else if (Math.abs(pct) > 50)
        fire(pct > 0 ? 'flow-up' : 'flow-down', 'medium', `Louet: flow ${pct > 0 ? '+' : ''}${Math.round(pct)}% (24h) — ${ctxTxt}`, { pct, cur, ref, refSrc, avg7 });
    }
  }
  // ---- quality: only when a measurement's DATE is new vs what history has seen ----
  for (const [param, cur2] of Object.entries(qlatest)) {
    const prevSeen = h.readings.slice(0, -1).map(r => (r.q || {})[param]).filter(Boolean);
    if (!prevSeen.length || prevSeen[prevSeen.length - 1].date === cur2.date) continue; // not a new sample
    const vals = [...new Map(prevSeen.map(x => [x.date, x.value])).values()]; // one per sample date
    const mean = vals.reduce((a, b) => a + b, 0) / vals.length;
    const sd = Math.sqrt(vals.reduce((a, b) => a + (b - mean) ** 2, 0) / vals.length);
    const sig = vals.length >= 4 && sd > 0
      ? Math.abs(cur2.value - mean) / sd > 2
      : mean !== 0 && Math.abs((cur2.value - mean) / mean) > 0.30;
    if (sig) fire(`q-${param}`, 'medium',
      `Louet: ${param} changed significantly — ${cur2.value}${cur2.unit} on ${cur2.date.slice(0, 10)} (recent mean ${mean.toFixed(2)}${cur2.unit})`,
      { param, value: cur2.value, mean, sd, n: vals.length });
  }
  lwrite(h);
  // medium alerts ride the next agent brief; high goes to Signal NOW via the Urgent Queue
  louetBriefAlerts = h.readings.length ? alerts.filter(a => a.level === 'medium').concat(
    // keep any alert from the last 24h visible in the brief (including highs)
    []) : alerts;
  const recent = Object.entries(h.lastAlert).filter(([, at]) => now - at < 24 * 3600e3);
  louetBriefAlerts = alerts; // current pass; brief also re-reads the log for 24h context
  for (const a of alerts.filter(x => x.level === 'high')) {
    try {
      const sid = ctx.config.todoSheetId;
      const id = Math.random().toString(36).slice(2, 10);
      await ctx.store.values.append({ spreadsheetId: sid, range: "'Urgent Queue'!A1", valueInputOption: 'RAW',
        requestBody: { values: [[new Date().toISOString(), 'Louet flood watch', a.text, 'high', 'nature-weather', '', id]] } });
    } catch (e) { lesc({ key: a.key, level: 'error', text: 'Urgent Queue append failed: ' + e.message }); }
  }
  return { alerts };
}
// last-24h escalations (from the log) — what the brief shows even between checks
function louetRecentAlerts() {
  try {
    const lines = fs.readFileSync(LESC, 'utf8').trim().split('\n').slice(-30);
    const cut = Date.now() - 24 * 3600e3;
    return lines.map(l => { try { return JSON.parse(l); } catch (e) { return null; } })
      .filter(e => e && e.level !== 'error' && Date.parse(e.at) > cut)
      .map(e => ({ kind: 'warn', text: e.text }));
  } catch (e) { return []; }
}

// —— the Louet moulin river gauge (unchanged from the water box) ——
const HUBEAU = 'https://hubeau.eaufrance.fr/api', VIGIEAU = 'https://api.vigieau.beta.gouv.fr/api';
const Q_STATION = '05234023', FLOW_STATION = 'Q041401001', MLAT = 43.400326, MLON = -0.049121;
async function water() {
  const tr = await getJson(`${HUBEAU}/v2/hydrometrie/observations_tr?code_entite=${FLOW_STATION}&grandeur_hydro=Q&size=1&sort=desc`);
  const o = tr && tr.data && tr.data[0];
  const since = new Date(Date.now() - 30 * 864e5).toISOString().slice(0, 10);
  const dj = await getJson(`${HUBEAU}/v2/hydrometrie/obs_elab?code_entite=${FLOW_STATION}&grandeur_hydro_elab=QmnJ&date_debut_obs_elab=${since}&size=40`);
  const series = ((dj && dj.data) || []).filter(o => o.resultat_obs_elab != null).map(o => o.resultat_obs_elab / 1000);
  const qj = await getJson(`${HUBEAU}/v2/qualite_rivieres/analyse_pc?code_station=${Q_STATION}&size=500&sort=desc&fields=date_prelevement,libelle_parametre,resultat,symbole_unite`);
  const latest = {}; for (const a of ((qj && qj.data) || [])) { const p = a.libelle_parametre, dd = a.date_prelevement; if (!latest[p] || dd > latest[p].date) latest[p] = { date: dd, value: a.resultat, unit: a.symbole_unite || '' }; }
  const keys = ['Potentiel en Hydrogène (pH)', 'Oxygène dissous', 'Taux de saturation en oxygène', 'Nitrates', 'Nitrites', 'Orthophosphates (PO4)', 'Ammonium', 'Conductivité à 25°C', 'Matières en suspension'];
  const dz = await getJson(`${VIGIEAU}/zones?lon=${MLON}&lat=${MLAT}&profil=particulier`);
  return {
    latestQ: o ? { m3s: o.resultat_obs / 1000, at: o.date_obs } : null,
    mean30: series.length ? series.reduce((s, x) => s + x, 0) / series.length : null,
    temp: latest['Température de l\'Eau'] || null,
    params: keys.filter(k => latest[k]).map(k => ({ name: k, value: latest[k].value, unit: latest[k].unit, date: latest[k].date })),
    drought: (Array.isArray(dz) ? dz : []).map(z => ({ type: z.type, gravite: z.niveauGravite, fin: z.arrete && z.arrete.dateFinValidite })).filter(z => z.gravite),
  };
}

// active locations = (pinned ∪ auto) − off ; each geocoded + forecast
async function buildWeather(ctx) {
  const store = await syncStore(ctx);
  const auto = autoLocations();
  const offSet = new Set((store.off || []).map(norm));
  const merged = []; const seen = new Set();
  for (const p of (store.pinned || [])) { if (seen.has(norm(p.name))) continue; seen.add(norm(p.name)); merged.push({ name: p.name, pinned: true, auto: false }); }
  for (const a of auto) { if (seen.has(norm(a.name))) { const m = merged.find(x => norm(x.name) === norm(a.name)); if (m) { m.auto = true; m.when = a; } continue; } seen.add(norm(a.name)); merged.push({ name: a.name, pinned: false, auto: true, when: a }); }
  const out = [];
  for (const m of merged) {
    if (offSet.has(norm(m.name))) { out.push({ ...m, off: true }); continue; }
    const geo = await geocode(m.name, store, ctx);
    const fc = geo.lat != null ? await forecast(geo.lat, geo.lon) : null;
    const surf = await surfFor(m.name, store, ctx).catch(() => []);
    out.push({ ...m, label: geo.label, lat: geo.lat, lon: geo.lon, fc, surf });
  }
  // include off (suppressed) locations too so the client can offer to re-enable them
  return out;
}

// severe-weather scan for the brief (only where the owner is / is going, next 3 days)
function salientWeather(weather) {
  const lines = [];
  const dow = d => new Date(d + 'T12:00').toLocaleDateString('en-GB', { weekday: 'short' });
  for (const w of (weather || [])) {
    if (w.off || !w.fc || !(w.auto)) continue; // only places you're actually going
    for (const day of w.fc.days.slice(0, 3)) {
      const sev = [];
      if (day.code >= 95) sev.push('thunderstorms');
      else if (day.pprob >= 80 && day.precip >= 15) sev.push('heavy rain (' + Math.round(day.precip) + 'mm)');
      if (day.min <= 0) sev.push('frost (' + Math.round(day.min) + '°)');
      if (day.max >= 37) sev.push('extreme heat (' + Math.round(day.max) + '°)');
      if (day.wind >= 60) sev.push('high wind (' + Math.round(day.wind) + ' km/h)');
      if (sev.length) { lines.push(`${w.name} ${dow(day.date)}: ${sev.join(', ')}`); break; } // one line per place
    }
  }
  return lines;
}

let cache = { at: 0, data: null };
async function getData(ctx) {
  if (cache.data && Date.now() - cache.at < TTL) return cache.data;
  const [weather, w] = await Promise.all([buildWeather(ctx).catch(() => []), water().catch(() => null)]);
  cache = { at: Date.now(), data: { weather, water: w, moon: moonPhase(), generated: new Date().toISOString() } };
  return cache.data;
}

module.exports = {
  key: 'nature-weather',
  title: '🌦 Nature & Weather',
  async data() { return getData(this._ctx || {}); },
  // capture ctx for data() (the loader calls data() without ctx); routes give us ctx once
  routes(app, ctx) {
    this._ctx = ctx;
    // Louet watch: hourly + shortly after boot (Mac tier only — NO_JOBS tiers skip inside)
    setTimeout(() => louetCheck(ctx).catch(e => lesc({ level: 'error', text: 'check failed: ' + e.message })), 2 * 60e3);
    setInterval(() => louetCheck(ctx).catch(e => lesc({ level: 'error', text: 'check failed: ' + e.message })), 3600e3);
    app.get('/api/louet/series', async (req, res) => { // cache-first; background refresh >6h
      if (String(req.query.raw || '') === '1') { // full 13-month series — client-side windowing
        let c0 = lfRead();
        if (!c0.daily.length) { await louetFlowRefresh(); c0 = lfRead(); }
        else if (Date.now() - c0.updatedAt > 6 * 3600e3 && Date.now() - (c0.attemptedAt || 0) > 3600e3) louetFlowRefresh();
        return res.json({ unit: 'm³/s', updatedAt: c0.updatedAt, daily: c0.daily });
      }
      const days = Math.min(185, Math.max(7, parseInt(req.query.days, 10) || 30));
      let c = lfRead();
      if (!c.daily.length) { await louetFlowRefresh(); c = lfRead(); } // first ever call: block once
      else if (Date.now() - c.updatedAt > 6 * 3600e3 && Date.now() - (c.attemptedAt || 0) > 3600e3) louetFlowRefresh(); // stale: serve now, refresh behind (attempt-paced)
      const today = new Date().toISOString().slice(0, 10);
      const from = new Date(Date.now() - days * 864e5).toISOString().slice(0, 10);
      const series = c.daily.filter(d => d.date >= from && d.date <= today);
      const lyFrom = new Date(Date.parse(from) - 365 * 864e5).toISOString().slice(0, 10);
      const lyTo = new Date(Date.parse(today) - 365 * 864e5).toISOString().slice(0, 10);
      // last year's points re-dated +365d so both lines share one x-axis
      const lastYear = c.daily.filter(d => d.date >= lyFrom && d.date <= lyTo)
        .map(d => ({ date: new Date(Date.parse(d.date) + 365 * 864e5).toISOString().slice(0, 10), m3s: d.m3s }));
      res.json({ unit: 'm³/s', days, updatedAt: c.updatedAt, series, lastYear });
    });
    app.get('/api/louet/status', async (req, res) => { // inspect history + run a check on demand
      const r = String(req.query.run || '') === '1' ? await louetCheck(ctx).catch(e => ({ error: e.message })) : null;
      const h = lread();
      res.json({ readings: h.readings.length, lastAlert: h.lastAlert, latest: h.readings[h.readings.length - 1] || null, runResult: r });
    });
    const bust = () => { cache = { at: 0, data: null }; };
    app.post('/api/weather/pin', async (req, res) => { // { name } — make an auto location permanent
      const s = await syncStore(ctx); const name = String((req.body || {}).name || '').trim(); if (!name) return res.status(400).json({ error: 'name' });
      const geo = await geocode(name, s, ctx);
      if (!s.pinned.some(p => norm(p.name) === norm(name))) s.pinned.push({ name, lat: geo.lat, lon: geo.lon, label: geo.label });
      s.off = (s.off || []).filter(n => norm(n) !== norm(name)); writeStore(s, ctx); bust(); res.json({ ok: true });
    });
    app.post('/api/weather/unpin', async (req, res) => {
      const s = await syncStore(ctx); const name = String((req.body || {}).name || '').trim();
      s.pinned = (s.pinned || []).filter(p => norm(p.name) !== norm(name)); writeStore(s, ctx); bust(); res.json({ ok: true });
    });
    app.post('/api/weather/toggle', async (req, res) => { // { name, on } — hide/show a location
      const s = await syncStore(ctx); const name = String((req.body || {}).name || '').trim(); const on = !!(req.body || {}).on;
      s.off = (s.off || []).filter(n => norm(n) !== norm(name)); if (!on) s.off.push(name); writeStore(s, ctx); bust(); res.json({ ok: true });
    });
    app.post('/api/weather/surf', async (req, res) => { // { location, spots: "a, b, c" } — set surf spots for a location (max 3)
      const s = await syncStore(ctx); const loc = String((req.body || {}).location || '').trim();
      const names = String((req.body || {}).spots || '').split(',').map(x => x.trim()).filter(Boolean).slice(0, 3);
      if (!loc) return res.status(400).json({ error: 'location' });
      s.surf = s.surf || {}; if (names.length) s.surf[norm(loc)] = names; else delete s.surf[norm(loc)];
      writeStore(s, ctx); bust(); res.json({ ok: true, spots: names });
    });
    app.post('/api/weather/add', async (req, res) => { // { name } — pin a brand-new place by name
      const s = await syncStore(ctx); const name = String((req.body || {}).name || '').trim(); if (!name) return res.status(400).json({ error: 'name' });
      const geo = await geocode(name, s, ctx); if (geo.lat == null) return res.status(422).json({ error: 'could not find "' + name + '"' });
      if (!s.pinned.some(p => norm(p.name) === norm(name))) s.pinned.push({ name, lat: geo.lat, lon: geo.lon, label: geo.label });
      writeStore(s, ctx); bust(); res.json({ ok: true, label: geo.label });
    });
  },
  // salient weather → Agent Brief (core folds this in and lets the LLM include it only if it outweighs the news)
  async briefItems() {
    let items = [];
    try { items = salientWeather((await getData(this._ctx || {})).weather).map(text => ({ kind: 'weather', text })); } catch (e) {}
    // Louet escalations from the last 24h always ride the brief (⚠️/🌊 lines)
    try { items = items.concat(louetRecentAlerts()); } catch (e) {}
    return items;
  },
  client: fs.readFileSync(path.join(__dirname, 'nature-weather.client.js'), 'utf8'),
};
